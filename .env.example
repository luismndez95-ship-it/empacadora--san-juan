# Copia este archivo como .env para desarrollo local (nunca commitear .env real)

# Secreto de firma de sesiones -- genera uno real con: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=cambia-esto-por-un-secreto-real

# Credenciales del primer administrador (la pareja duena del negocio)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Marca que estamos en desarrollo local (permite cookies de sesion sin HTTPS)
LOCAL_DEV=1

# Contacto de la landing publica (/landing). Opcionales: sin ellos no se muestran los botones.
# WhatsApp: codigo de pais + numero, solo digitos (Costa Rica: 506XXXXXXXX)
LANDING_WHATSAPP=506XXXXXXXX
LANDING_EMAIL=correo@ejemplo.com
